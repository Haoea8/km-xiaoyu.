# 环境变量模板（复制为 .env 或直接导出为环境变量后按需修改）
# 本文件**不含任何真实凭据**，可安全提交到公开仓库。
#
# 说明：本项目绝大多数配置不需要改 —— 云开发环境 ID 已写在
#       miniprogram/utils/config.js 与 server/src/cloud.js 里。

# ---------- 本地服务端口 ----------
API_PORT=3000
API_HOST=127.0.0.1
ADMIN_PORT=3100
# 0.0.0.0 = 同一 WiFi 下手机/其它电脑可访问；127.0.0.1 = 仅本机
ADMIN_HOST=0.0.0.0

# ---------- 云开发 ----------
# 云环境 ID（云开发控制台左上角可见）
CLOUDBASE_ENV_ID=
# CloudBase API Key：填了「本地管理后台」才会读线上真实数据；
# 不填则使用本地演示库 server/data/db.json（安全，默认推荐）
# ⚠️ 管理员权限、长期有效，切勿提交到仓库
CLOUDBASE_API_KEY=

# ---------- AI（可选） ----------
# 不配置时 AI 能力自动降级为规则实现，功能不报错
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
