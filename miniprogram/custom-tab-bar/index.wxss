.tb {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 200;
  height: 104rpx; padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20rpx);
  display: flex; align-items: stretch;
  box-shadow: 0 -4rpx 24rpx rgba(31, 35, 40, 0.06);
}
.tb-item {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 4rpx;
  position: relative;
  transition: opacity 0.15s ease;
}
.tb-item:active { opacity: 0.7; }
.tb-text { font-size: 20rpx; color: #9AA0A6; line-height: 1.2; transition: color 0.15s ease; }
.tb-active .tb-text { color: #1FA45B; font-weight: 600; }

/* ---- 图标（纯 CSS 绘制） ---- */
.tb-ico { width: 44rpx; height: 44rpx; position: relative; }
.tb-badge {
  position: absolute; top: -10rpx; right: -22rpx;
  min-width: 30rpx; height: 30rpx; padding: 0 8rpx; box-sizing: border-box;
  background: #FF3B30; color: #fff; font-size: 18rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
}

/* 首页 */
.tb-ico-home::before {
  content: ''; position: absolute; left: 8rpx; top: 0;
  width: 0; height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 14rpx solid #9AA0A6;
}
.tb-ico-home::after {
  content: ''; position: absolute; left: 10rpx; top: 12rpx;
  width: 24rpx; height: 20rpx; border-radius: 0 0 6rpx 6rpx;
  border: 4rpx solid #9AA0A6; border-top: none;
}
.tb-active .tb-ico-home::before { border-bottom-color: #1FA45B; }
.tb-active .tb-ico-home::after { border-color: #1FA45B; border-top: none; }

/* 圈子 */
.tb-ico-circle::before {
  content: ''; position: absolute; left: 2rpx; top: 10rpx;
  width: 22rpx; height: 22rpx; border-radius: 50%; border: 4rpx solid #9AA0A6;
}
.tb-ico-circle::after {
  content: ''; position: absolute; right: 2rpx; top: 6rpx;
  width: 20rpx; height: 20rpx; border-radius: 50%; border: 4rpx solid #9AA0A6;
  background: #fff;
}
.tb-active .tb-ico-circle::before,
.tb-active .tb-ico-circle::after { border-color: #1FA45B; }

/* 消息 */
.tb-ico-message::before {
  content: ''; position: absolute; left: 4rpx; top: 8rpx;
  width: 32rpx; height: 24rpx; border-radius: 12rpx 12rpx 12rpx 2rpx;
  border: 4rpx solid #9AA0A6;
}
.tb-ico-message::after {
  content: ''; position: absolute; left: 12rpx; bottom: 2rpx;
  width: 0; height: 0;
  border-top: 8rpx solid #9AA0A6;
  border-right: 8rpx solid transparent;
}
.tb-active .tb-ico-message::before { border-color: #1FA45B; }
.tb-active .tb-ico-message::after { border-top-color: #1FA45B; }

/* 我的 */
.tb-ico-mine::before {
  content: ''; position: absolute; left: 14rpx; top: 4rpx;
  width: 16rpx; height: 16rpx; border-radius: 50%; border: 4rpx solid #9AA0A6;
}
.tb-ico-mine::after {
  content: ''; position: absolute; left: 6rpx; top: 26rpx;
  width: 32rpx; height: 20rpx; border-radius: 16rpx 16rpx 6rpx 6rpx;
  border: 4rpx solid #9AA0A6; border-bottom: none;
}
.tb-active .tb-ico-mine::before,
.tb-active .tb-ico-mine::after { border-color: #1FA45B; }

/* ---- 中间发布 ---- */
.tb-publish { flex: 1.15; }
.tb-plus {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: linear-gradient(135deg, #FFD24D 0%, #FFB300 45%, #7FD97B 80%, #22B573 100%);
  box-shadow: 0 10rpx 24rpx rgba(23, 138, 74, 0.35), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.35);
  display: flex; align-items: center; justify-content: center;
  position: relative; margin-top: -34rpx;
  transition: transform 0.15s ease;
}
.tb-plus:active { transform: scale(0.93); }
.tb-plus-h, .tb-plus-v {
  position: absolute; background: #fff; border-radius: 4rpx;
}
.tb-plus-h { width: 36rpx; height: 6rpx; }
.tb-plus-v { width: 6rpx; height: 36rpx; }
.tb-pub-text { font-size: 20rpx; color: #9AA0A6; margin-top: 2rpx; }
