/* ---------- 状态头 ---------- */
.hero {
  background: var(--brand-grad);
  padding: 40rpx 32rpx 48rpx;
  color: #fff;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}
.hero-status { font-size: 46rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-sub { font-size: 24rpx; opacity: 0.9; margin-top: 12rpx; }

.steps { display: flex; align-items: flex-start; margin-top: 44rpx; }
.step { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; }
.step-dot {
  width: 34rpx; height: 34rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.35);
  display: flex; align-items: center; justify-content: center; z-index: 2;
}
.step-dot.on { background: #fff; }
.step-core { width: 14rpx; height: 14rpx; border-radius: 50%; background: transparent; }
.step-dot.on .step-core { background: var(--brand); }
.step-label { font-size: 22rpx; margin-top: 12rpx; opacity: 0.7; }
.step-label.on { opacity: 1; font-weight: 600; }
.step-line {
  position: absolute; top: 16rpx; left: 50%; width: 100%;
  height: 4rpx; background: rgba(255, 255, 255, 0.3); z-index: 1;
}

/* ---------- 卡片 ---------- */
.card { margin: 20rpx 24rpx 0; padding: 28rpx; }

/* ---------- 担保 ---------- */
.esc-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26rpx; }
.esc-title-row { display: flex; align-items: center; gap: 12rpx; }
.esc-shield { font-size: 30rpx; }
.esc-title { font-size: 31rpx; font-weight: 700; }
.esc-status {
  font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 999rpx;
  background: #F2F4F7; color: var(--ink-2); font-weight: 600;
}
.esc-status.holding { background: #FFF3E0; color: #E88A00; }
.esc-status.released { background: #E6F8F0; color: var(--green); }
.esc-status.refunded { background: #FFEBEE; color: #E53935; }

.esc-steps { padding-left: 6rpx; }
.es-item { display: flex; gap: 18rpx; }
.es-left { display: flex; flex-direction: column; align-items: center; width: 32rpx; flex-shrink: 0; }
.es-dot {
  width: 22rpx; height: 22rpx; border-radius: 50%;
  border: 4rpx solid #D8DEE6; box-sizing: border-box; background: #fff; margin-top: 8rpx;
}
.es-dot.on { border-color: var(--brand); background: var(--brand); }
.es-line { flex: 1; width: 3rpx; background: #E8ECF1; margin: 6rpx 0; min-height: 34rpx; }
.es-body { flex: 1; padding-bottom: 26rpx; }
.es-label { font-size: 27rpx; color: var(--ink-3); }
.es-label.on { color: var(--ink); font-weight: 600; }
.es-sub { font-size: 21rpx; color: var(--ink-4); margin-top: 6rpx; line-height: 1.5; }
.es-item:last-child .es-body { padding-bottom: 0; }

.esc-amount {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 22rpx; padding-top: 22rpx; border-top: 2rpx solid var(--line);
}
.ea-label { font-size: 25rpx; color: var(--ink-3); }
.ea-val { font-size: 38rpx; color: var(--brand); font-weight: 700; }

.esc-more {
  text-align: center; font-size: 23rpx; color: var(--brand);
  padding: 22rpx 0 0;
}
.esc-points { margin-top: 16rpx; background: #FAFBFC; border-radius: 16rpx; padding: 20rpx 22rpx; }
.ep-item { font-size: 22rpx; color: var(--ink-2); line-height: 1.75; }

.esc-intervene {
  margin-top: 22rpx; height: 76rpx; border-radius: 999rpx;
  background: #E4F6EC; color: var(--brand);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 600;
}

/* ---------- 交付 ---------- */
.addr-card { display: flex; align-items: center; gap: 20rpx; }
.addr-icon {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--brand-soft); color: var(--brand);
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; flex-shrink: 0;
}
.addr-main { flex: 1; min-width: 0; }
.addr-title { font-size: 29rpx; font-weight: 600; }
.addr-sub { font-size: 23rpx; color: var(--ink-3); margin-top: 4rpx; }

/* ---------- 商品 ---------- */
.goods-card { display: flex; gap: 20rpx; align-items: center; }
.g-img { width: 160rpx; height: 160rpx; border-radius: 16rpx; background: #F1F3F5; flex-shrink: 0; }
.g-info { flex: 1; min-width: 0; }
.g-title {
  font-size: 28rpx; font-weight: 600; line-height: 1.45;
  overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.g-meta { display: flex; gap: 10rpx; margin-top: 10rpx; }
.mini-tag { font-size: 20rpx; color: var(--ink-2); background: #F2F4F7; padding: 2rpx 12rpx; border-radius: 6rpx; }
.mini-tag.group { color: var(--brand); background: var(--brand-soft); }
.g-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }
.g-price { font-size: 30rpx; font-weight: 700; color: var(--brand); }
.g-qty { font-size: 24rpx; color: var(--ink-3); }

/* ---------- 行 ---------- */
.row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; gap: 20rpx; }
.row-l { font-size: 26rpx; color: var(--ink-2); flex-shrink: 0; }
.row-r { font-size: 27rpx; font-weight: 500; text-align: right; }
.row-r.free { color: var(--green); }
.row-r.mono { font-family: "DIN Alternate", monospace; font-size: 25rpx; }
.row-r.link { color: var(--blue); }
.row-r.warn { color: #E53935; }
.copy { font-size: 21rpx; color: var(--brand); margin-left: 10rpx; }
.row.total { border-top: 2rpx solid var(--line); margin-top: 10rpx; padding-top: 22rpx; }
.row.total .row-l { font-size: 28rpx; color: var(--ink); font-weight: 600; }
.row-r.big { font-size: 40rpx; color: var(--brand); font-weight: 700; }
.yuan { font-size: 24rpx; }
.pay-type { font-size: 22rpx; color: var(--ink-3); text-align: right; padding-top: 10rpx; }

/* ---------- 时间线 ---------- */
.card-title { font-size: 28rpx; font-weight: 600; margin-bottom: 22rpx; }
.tl-item { display: flex; gap: 18rpx; }
.tl-left { display: flex; flex-direction: column; align-items: center; width: 56rpx; flex-shrink: 0; }
.tl-ico {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #F5F7FA; display: flex; align-items: center; justify-content: center;
  font-size: 26rpx;
}
.tl-line { flex: 1; width: 3rpx; background: var(--line); margin: 6rpx 0; min-height: 30rpx; }
.tl-body { flex: 1; padding-bottom: 30rpx; }
.tl-note { font-size: 27rpx; line-height: 1.5; }
.tl-time { font-size: 21rpx; color: var(--ink-4); margin-top: 6rpx; }
.tl-item:last-child .tl-body { padding-bottom: 0; }

/* ---------- 提示 ---------- */
.tip-card {
  margin: 20rpx 24rpx 0; padding: 24rpx;
  background: #FFF8E6; border-radius: var(--radius);
  display: flex; align-items: center; gap: 14rpx;
}
.tip-ico {
  width: 36rpx; height: 36rpx; border-radius: 50%; background: #FFB300; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; flex-shrink: 0;
}
.tip-text { font-size: 23rpx; color: #A36A00; flex: 1; }

/* ---------- 底部 ---------- */
.footer-pad { height: calc(170rpx + env(safe-area-inset-bottom)); }
.footer {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  background: #fff; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex; align-items: center; justify-content: flex-end; gap: 16rpx;
  box-shadow: 0 -6rpx 24rpx rgba(31, 35, 40, 0.06);
}
.f-btn {
  height: 80rpx; padding: 0 40rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 27rpx; font-weight: 500;
}
.f-ghost { border: 2rpx solid var(--line); background: #fff; color: var(--ink-2); }
.f-main {
  background: var(--brand-grad); color: #fff; font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(31, 164, 91, 0.26);
}
.f-btn:active { opacity: 0.86; }

.loading-wrap { padding-top: 20rpx; }

.row-r.muted { color: #9AA0A6; }
