.card { margin: 20rpx 24rpx 0; padding: 28rpx; }

/* ---------- 拼团提示 ---------- */
.group-banner {
  display: flex; align-items: center; gap: 18rpx;
  margin: 20rpx 24rpx 0; padding: 26rpx 28rpx;
  background: linear-gradient(135deg, #E4F6EC, #D8F2E2);
  border-radius: var(--radius-lg);
}
.gb-ico { font-size: 48rpx; }
.gb-main { flex: 1; min-width: 0; }
.gb-title { font-size: 29rpx; font-weight: 700; color: var(--brand-dark); }
.gb-sub { font-size: 22rpx; color: #B4553A; margin-top: 6rpx; }

/* ---------- 交付方式 ---------- */
.addr-card { display: flex; align-items: center; gap: 20rpx; }
.addr-icon {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: var(--brand-soft); color: var(--brand);
  display: flex; align-items: center; justify-content: center; font-size: 34rpx; flex-shrink: 0;
}
.addr-main { flex: 1; min-width: 0; }
.addr-title { font-size: 30rpx; font-weight: 600; }
.addr-sub { font-size: 23rpx; color: var(--ink-3); margin-top: 4rpx; }

/* ---------- 商品 ---------- */
.shop-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 22rpx; }
.shop-avatar {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: var(--brand-grad); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 600;
}
.shop-name { font-size: 26rpx; font-weight: 500; flex: 1; }
.tag-zone { font-size: 21rpx; color: var(--blue); background: #E8F5FE; padding: 2rpx 14rpx; border-radius: 8rpx; }

.goods { display: flex; gap: 20rpx; }
.goods-img { width: 180rpx; height: 180rpx; border-radius: 18rpx; background: #F1F3F5; flex-shrink: 0; }
.goods-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.goods-title {
  font-size: 28rpx; font-weight: 600; line-height: 1.45;
  overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.goods-tags { display: flex; gap: 10rpx; margin-top: 10rpx; }
.mini-tag { font-size: 20rpx; color: var(--ink-2); background: #F2F4F7; padding: 2rpx 12rpx; border-radius: 6rpx; }
.goods-bottom { margin-top: auto; display: flex; align-items: center; justify-content: space-between; }
.price-wrap { display: flex; align-items: baseline; }
.yuan { font-size: 22rpx; color: var(--brand); font-weight: 700; }
.price { font-size: 36rpx; color: var(--brand); font-weight: 700; margin-left: 2rpx; }
.origin { font-size: 20rpx; color: var(--ink-4); text-decoration: line-through; margin-left: 10rpx; }
.qty-fixed { font-size: 26rpx; color: var(--ink-3); }

.stepper { display: flex; align-items: center; border: 2rpx solid var(--line); border-radius: 12rpx; overflow: hidden; }
.step-btn {
  width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: var(--ink-2); background: #FAFBFC;
}
.step-btn.disabled { color: var(--ink-4); }
.step-num { width: 76rpx; height: 56rpx; text-align: center; font-size: 28rpx; font-weight: 600; }

/* ---------- 交易方式 ---------- */
.card-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.method-list { display: flex; flex-direction: column; }
.method-item { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; }
.method-name { font-size: 28rpx; color: var(--ink-2); }
.method-item.active .method-name { color: var(--ink); font-weight: 600; }

.radio {
  width: 38rpx; height: 38rpx; border-radius: 50%;
  border: 2rpx solid var(--ink-4); box-sizing: border-box;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.active .radio { border-color: var(--brand); background: var(--brand); }
.radio-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: transparent; }
.active .radio-dot { background: #fff; }

/* ---------- 留言 ---------- */
.remark {
  width: 100%; min-height: 130rpx; font-size: 27rpx; line-height: 1.6;
  background: #FAFBFC; border-radius: 16rpx; padding: 22rpx; box-sizing: border-box;
}
.ph { color: var(--ink-4); }
.count { text-align: right; font-size: 21rpx; color: var(--ink-4); margin-top: 10rpx; }

/* ---------- 金额 ---------- */
.amount-row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; }
.row-l { font-size: 26rpx; color: var(--ink-2); }
.row-r { font-size: 27rpx; font-weight: 500; }
.row-r.free { color: var(--green); font-size: 25rpx; }
.amount-row.total { border-top: 2rpx solid var(--line); margin-top: 10rpx; padding-top: 22rpx; }
.amount-row.total .row-l { font-size: 28rpx; color: var(--ink); font-weight: 600; }
.row-r.big { font-size: 40rpx; color: var(--brand); font-weight: 700; }

/* ---------- 支付方式 ---------- */
.pay-item { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; }
.pay-left { display: flex; align-items: center; gap: 18rpx; }
.pay-icon {
  width: 64rpx; height: 64rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 28rpx; font-weight: 600;
}
.pay-icon.balance { background: linear-gradient(135deg, #FFD24D, #F5A623); }
.pay-icon.wx { background: linear-gradient(135deg, #5BE07A, #22B573); }
.pay-name { font-size: 28rpx; font-weight: 500; }
.pay-sub { font-size: 22rpx; color: var(--ink-3); margin-top: 2rpx; }

.safe-tip { text-align: center; font-size: 22rpx; color: var(--ink-3); padding: 30rpx 40rpx 0; }

/* ---------- 底部栏 ---------- */
.footer-pad { height: calc(190rpx + env(safe-area-inset-bottom)); }
.footer {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  background: #fff; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex; align-items: center; justify-content: space-between;
  box-shadow: 0 -6rpx 24rpx rgba(31, 35, 40, 0.06);
}
.foot-total { display: flex; align-items: baseline; }
.foot-label { font-size: 24rpx; color: var(--ink-2); margin-right: 8rpx; }
.foot-price { font-size: 44rpx; color: var(--brand); font-weight: 700; }
.yuan-big { font-size: 26rpx; color: var(--brand); font-weight: 700; }
.foot-btns { display: flex; align-items: center; gap: 16rpx; }
.btn-ghost {
  height: 84rpx; padding: 0 32rpx; border-radius: 999rpx;
  border: 2rpx solid var(--line); background: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: var(--ink-2); font-weight: 500;
}
.btn-main {
  height: 84rpx; padding: 0 56rpx; border-radius: 999rpx;
  background: var(--brand-grad); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(31, 164, 91, 0.28);
}
.btn-main.disabled { opacity: 0.6; }

.loading-wrap { padding: 24rpx 0; }
.loading-text { text-align: center; color: var(--ink-3); font-size: 26rpx; margin-top: 20rpx; }
