.chat-page { min-height: 100vh; background: #F2F4F7; }

/* ---------- 顶部导航 ---------- */
.nav {
  position: fixed; left: 0; right: 0; top: 0; z-index: 80;
  background: rgba(255, 255, 255, 0.98);
  border-bottom: 2rpx solid var(--line);
}
.nav-inner { display: flex; align-items: center; padding: 0 24rpx; }
.nav-back { width: 70rpx; height: 70rpx; display: flex; align-items: center; justify-content: center; }
.nav-arrow {
  width: 22rpx; height: 22rpx;
  border-left: 4rpx solid var(--ink); border-bottom: 4rpx solid var(--ink);
  transform: rotate(45deg); margin-left: 8rpx;
}
.nav-title { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.nav-name { font-size: 31rpx; font-weight: 600; max-width: 400rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nav-tag {
  font-size: 18rpx; color: #fff; background: linear-gradient(135deg, #FFD24D, #F5A623);
  padding: 1rpx 12rpx; border-radius: 999rpx; margin-top: 2rpx;
}
.nav-typing { font-size: 19rpx; color: var(--green); margin-top: 2rpx; }
.nav-right { width: 70rpx; display: flex; align-items: center; justify-content: flex-end; }
.nav-more { font-size: 40rpx; color: var(--ink-2); padding: 0 12rpx; line-height: 1; }

/* ---------- 消息区 ---------- */
.msgs { position: fixed; left: 0; right: 0; }
.msgs-pad { height: 24rpx; }
.more-tip { text-align: center; font-size: 21rpx; color: var(--ink-4); padding: 16rpx 40rpx 24rpx; }
.msgs-bottom { height: 40rpx; }

/* ---------- 系统消息 ---------- */
.sys-row { display: flex; justify-content: center; padding: 20rpx 60rpx; }
.sys-bubble {
  background: rgba(0, 0, 0, 0.06); color: var(--ink-2);
  font-size: 22rpx; padding: 10rpx 22rpx; border-radius: 14rpx;
  text-align: center; line-height: 1.5;
}

/* ---------- 消息行 ---------- */
.msg-row { display: flex; align-items: flex-start; gap: 16rpx; padding: 12rpx 24rpx; }
.msg-row.mine { flex-direction: row-reverse; }
.m-avatar { width: 76rpx; height: 76rpx; border-radius: 22rpx; background: #E6E9ED; flex-shrink: 0; }
/* 没有头像（或图片加载失败）时的字标兜底：同尺寸、同圆角，绝不留一块空白灰 */
.m-avatar.av-letter {
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 600; line-height: 1;
  overflow: hidden;
}
.m-body { max-width: 74%; display: flex; flex-direction: column; }
.msg-row.mine .m-body { align-items: flex-end; }

.bubble { padding: 20rpx 26rpx; border-radius: 22rpx; font-size: 29rpx; line-height: 1.5; word-break: break-all; }
.b-peer { background: #fff; color: var(--ink); border-top-left-radius: 6rpx; box-shadow: 0 2rpx 10rpx rgba(31, 35, 40, 0.05); }
.b-mine {
  background: linear-gradient(135deg, #4CD08A, #1FA45B); color: #fff;
  border-top-right-radius: 6rpx; box-shadow: 0 4rpx 14rpx rgba(23, 138, 74, 0.24);
}

.bubble-img { border-radius: 18rpx; overflow: hidden; max-width: 400rpx; }
.m-img { width: 400rpx; border-radius: 18rpx; display: block; }
/* 图片正在上传：半透明表示「还没发出去」 */
.bubble-img.sending { opacity: .55; }

.m-meta { display: flex; align-items: center; gap: 10rpx; margin-top: 8rpx; padding: 0 6rpx; }
.m-time { font-size: 19rpx; color: var(--ink-4); }
.m-read { font-size: 19rpx; color: var(--green); }

.typing-bubble { display: flex; align-items: center; gap: 8rpx; padding: 24rpx 28rpx; }
.dot-ani { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--ink-4); animation: typingBlink 1.2s infinite ease-in-out; }
.dot-ani.d2 { animation-delay: 0.18s; }
.dot-ani.d3 { animation-delay: 0.36s; }
@keyframes typingBlink {
  0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-6rpx); }
}

/* ---------- 商品卡片消息 ---------- */
.card-msg {
  width: 500rpx; background: #fff; border-radius: 20rpx;
  padding: 20rpx; display: flex; align-items: center; gap: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 40, 0.07);
  position: relative;
}
.cm-img { width: 120rpx; height: 120rpx; border-radius: 14rpx; background: #F1F3F5; flex-shrink: 0; }
.cm-main { flex: 1; min-width: 0; }
.cm-title {
  font-size: 26rpx; font-weight: 500; line-height: 1.4;
  overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.cm-price { font-size: 30rpx; color: var(--brand); font-weight: 700; margin-top: 10rpx; }
.cm-price.cm-order { font-size: 24rpx; color: var(--purple); }
.cm-unit { font-size: 20rpx; font-weight: 400; color: var(--ink-3); }
.cm-badge {
  position: absolute; top: -10rpx; right: -10rpx;
  background: var(--brand-grad); color: #fff;
  font-size: 19rpx; padding: 3rpx 14rpx; border-radius: 999rpx;
}
.cm-badge-order { background: linear-gradient(135deg, #FFD24D, #F5A623); }

/* ---------- 推荐横滑 ---------- */
.reco-wrap { width: 100%; }
.reco { white-space: nowrap; display: flex;
  height: 310rpx;
  box-sizing: border-box;
}
.reco-item {
  width: 220rpx; background: #fff; border-radius: 18rpx;
  padding: 14rpx; margin-right: 14rpx; flex-shrink: 0;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 40, 0.06);
}
.reco-img { width: 100%; height: 190rpx; border-radius: 12rpx; background: #F1F3F5; }
.reco-title { font-size: 23rpx; margin-top: 10rpx; }
.reco-price { font-size: 26rpx; color: var(--brand); font-weight: 700; margin-top: 4rpx; }

/* ---------- AI 快捷提问 ---------- */
.qr-wrap { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.qr {
  font-size: 23rpx; color: var(--purple);
  background: #F1EDFE; border: 2rpx solid rgba(122, 90, 248, 0.18);
  padding: 10rpx 22rpx; border-radius: 999rpx;
}

/* ---------- 底部 ---------- */
.bottom-wrap { position: fixed; left: 0; right: 0; bottom: 0; z-index: 70; background: #fff; }
.input-bar {
  display: flex; align-items: center; gap: 14rpx;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--line);
}
.ib-more, .ib-emoji {
  width: 62rpx; height: 62rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; color: var(--ink-2); background: #F4F6F8; flex-shrink: 0;
}
.ib-input { flex: 1; height: 68rpx; background: #F4F6F8; border-radius: 999rpx; padding: 0 26rpx; font-size: 28rpx; }
.ib-ph { color: var(--ink-4); font-size: 26rpx; }
.ib-send {
  height: 68rpx; padding: 0 32rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 27rpx; color: #fff; background: #C9CFD8; flex-shrink: 0;
}
.ib-send.on { background: var(--brand-grad); font-weight: 600; box-shadow: 0 6rpx 16rpx rgba(31, 164, 91, 0.26); }

/* ---------- 面板 ---------- */
.panel {
  border-top: 2rpx solid var(--line);
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  max-height: 460rpx; overflow: hidden;
}
.panel-title { font-size: 23rpx; color: var(--ink-3); margin-bottom: 18rpx; }

.emoji-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.emoji {
  width: 100rpx; height: 100rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 46rpx; background: #F7F8FA;
}

.quick-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.quick-item { font-size: 25rpx; color: var(--ink-2); background: #F4F6F8; padding: 14rpx 28rpx; border-radius: 999rpx; }
.quick-item:active { background: var(--brand-soft); color: var(--brand); }

.more-actions { display: flex; gap: 48rpx; padding-bottom: 8rpx; }
.ma-item { display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.ma-ico { width: 108rpx; height: 108rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.ico-img { background: #E8F5FE; }
.ico-quick { background: #E4F6EC; }
.ico-order { background: #F1EDFE; }
.ico-mine { background: #E6F8F0; }
.ma-label { font-size: 22rpx; color: var(--ink-2); }

.my-list { white-space: nowrap; display: flex; margin-top: 6rpx;
  height: 210rpx;
  box-sizing: border-box;
}
.ml-item {
  width: 190rpx; margin-right: 16rpx; flex-shrink: 0;
  background: #FAFBFC; border-radius: 16rpx; overflow: hidden; padding-bottom: 12rpx;
}
.ml-img { width: 100%; height: 150rpx; background: #F1F3F5; }
.ml-title { font-size: 21rpx; padding: 10rpx 12rpx 0; }
.ml-item:active { background: var(--brand-soft); }
