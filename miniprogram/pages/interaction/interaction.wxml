<view class="page-wrap">
  <navbar title="互动消息" back="{{true}}"></navbar>

  <block wx:if="{{logged}}">
    <view class="head" wx:if="{{total}}">
      <text class="head-t">共 {{total}} 条互动</text>
      <text class="head-s">点任意一条可回到内容位置</text>
    </view>

    <view class="list">
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="it-row {{item.isNew ? 'is-new' : ''}}"
        data-i="{{index}}"
        bindtap="open">
        <!-- 头像：字标兜底 + 图片两层（图片空/加载失败时露出字标，永远不会是白块） -->
        <view class="it-av" data-uid="{{item.actorId}}" catchtap="openActor">
          <view class="it-av-bg" style="background:{{item.av.bg}};color:{{item.av.fg}}">{{item.av.letter}}</view>
          <image wx:if="{{item.avatar}}" class="it-av-img" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="it-ico">{{item.icon}}</view>
        </view>

        <view class="it-main">
          <view class="it-line">
            <text class="it-name">{{item.actorName}}</text>
            <text class="it-type">{{item.typeText}}</text>
            <text class="it-time">{{item.timeText}}</text>
          </view>
          <view wx:if="{{item.preview}}" class="it-preview ellipsis2">{{item.preview}}</view>
          <view wx:if="{{item.sub}}" class="it-sub ellipsis">{{item.sub}}</view>
        </view>

        <image wx:if="{{item.thumb}}" class="it-thumb" src="{{item.thumb}}" mode="aspectFill" lazy-load></image>
        <view wx:else class="it-arrow">›</view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="skeleton-wrap">
      <view class="skeleton sk-row" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
    </view>

    <empty wx:if="{{!loading && !list.length}}" text="还没有互动消息" sub="别人点赞、评论、收藏了你的内容就会出现在这里"></empty>

    <view wx:if="{{!loading && list.length && !hasMore}}" class="list-end">没有更多了</view>
  </block>

  <!-- 未登录 -->
  <view wx:else class="guest">
    <view class="guest-ico">🔔</view>
    <view class="guest-title">登录后查看互动消息</view>
    <view class="guest-sub">谁赞了你、评论了你、收藏了你，都会在这里</view>
    <view class="guest-btn" bindtap="goLogin">微信一键登录</view>
  </view>

  <view class="bottom-pad"></view>
</view>
