.nb-add {
  font-size: 24rpx; color: #fff; font-weight: 600;
  background: var(--brand-grad); padding: 6rpx 24rpx; border-radius: 999rpx;
}

.tip {
  display: flex; gap: 14rpx; margin: 20rpx 24rpx 0;
  padding: 22rpx 24rpx; background: #FFF8E6; border-radius: var(--radius);
  font-size: 22rpx; color: #A36A00; line-height: 1.55;
}
.tip-ico { font-size: 26rpx; flex-shrink: 0; }

.list { padding: 20rpx 24rpx 0; }
.a-card {
  background: #fff; border-radius: var(--radius-lg);
  padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}
.a-main:active { opacity: 0.8; }
.a-head { display: flex; align-items: center; gap: 16rpx; }
.a-name { font-size: 30rpx; font-weight: 700; }
.a-phone { font-size: 25rpx; color: var(--ink-2); }
.a-default {
  font-size: 19rpx; color: var(--brand); background: var(--brand-soft);
  padding: 3rpx 14rpx; border-radius: 6rpx;
}
.a-detail { font-size: 25rpx; color: var(--ink-3); margin-top: 14rpx; line-height: 1.5; }

.a-acts {
  display: flex; align-items: center; justify-content: flex-end; gap: 16rpx;
  margin-top: 22rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line);
}
.a-act {
  font-size: 23rpx; color: var(--ink-2);
  border: 2rpx solid var(--line); padding: 8rpx 24rpx; border-radius: 999rpx;
}
.a-act.danger { color: #E53935; border-color: #FFCDD2; }

.fab-text {
  position: fixed; left: 24rpx; right: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 92rpx; border-radius: 999rpx;
  background: var(--brand-grad); color: #fff;
  font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 26rpx rgba(31, 164, 91, 0.3);
}
.bottom-pad { height: 180rpx; }

/* ---------- 编辑面板 ---------- */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 200;
  background: rgba(0, 0, 0, 0.5); display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: #fff; border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.26s ease both;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: none; } }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.sheet-title { font-size: 34rpx; font-weight: 700; }
.sheet-close { font-size: 44rpx; color: var(--ink-4); line-height: 1; padding: 0 10rpx; }

.field { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 2rpx solid var(--line); }
.field-label { width: 160rpx; color: var(--ink-3); font-size: 27rpx; flex-shrink: 0; }
.field-input { flex: 1; font-size: 28rpx; }
.ph { color: var(--ink-4); }

.default-row { display: flex; align-items: center; gap: 12rpx; margin-top: 24rpx; }
.checkbox {
  width: 34rpx; height: 34rpx; border-radius: 50%;
  border: 3rpx solid var(--ink-4); box-sizing: border-box; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.checkbox.on { background: var(--brand); border-color: var(--brand); }
.tick {
  width: 14rpx; height: 8rpx;
  border-left: 3rpx solid #fff; border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg) translate(1rpx, -2rpx); opacity: 0;
}
.checkbox.on .tick { opacity: 1; }
.default-text { font-size: 25rpx; color: var(--ink-2); }

.sheet-submit {
  margin-top: 30rpx; height: 92rpx; border-radius: 999rpx;
  background: var(--brand-grad); color: #fff; font-size: 31rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 26rpx rgba(31, 164, 91, 0.3);
}
.sheet-submit.disabled { opacity: 0.6; }
