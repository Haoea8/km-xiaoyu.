.nb-post {
  font-size: 24rpx; color: #fff; font-weight: 600;
  background: var(--brand-grad); padding: 6rpx 24rpx; border-radius: 999rpx;
}

/* ---------- 搜索 ---------- */
.search-wrap { padding: 8rpx 24rpx 4rpx; }
.search {
  display: flex; align-items: center; gap: 14rpx;
  background: #fff; border-radius: 999rpx;
  padding: 0 26rpx; height: 76rpx; box-shadow: var(--shadow);
}
.s-ico {
  width: 26rpx; height: 26rpx; border-radius: 50%;
  border: 4rpx solid var(--ink-4); position: relative; flex-shrink: 0;
}
.s-ico::after {
  content: ''; position: absolute; right: -12rpx; bottom: -8rpx;
  width: 14rpx; height: 4rpx; background: var(--ink-4); transform: rotate(45deg); border-radius: 2rpx;
}
.s-input { flex: 1; font-size: 27rpx; }
.s-ph { color: var(--ink-4); }
.s-clear {
  width: 40rpx; height: 40rpx; border-radius: 50%; background: #E8EBEF;
  color: var(--ink-3); display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; line-height: 1;
}

/* ---------- 圈子 ---------- */
.sec { padding: 28rpx 0 0; }
.sec-head { display: flex; align-items: baseline; justify-content: space-between; padding: 0 32rpx 18rpx; }
.sec-title { font-size: 32rpx; font-weight: 700; }
.sec-sub { font-size: 22rpx; color: var(--ink-4); }

/* scroll-view 必须显式给高度，否则内容会塌陷、下方文字被裁掉 */
.circle-scroll {
  white-space: nowrap; display: flex;
  height: 216rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.circle-item {
  width: 168rpx; flex-shrink: 0; margin-right: 18rpx;
  background: #fff; border-radius: var(--radius);
  padding: 24rpx 0 20rpx; text-align: center;
  box-sizing: border-box;
  box-shadow: var(--shadow);
}
.circle-item:active { transform: scale(0.97); }
.ci-ico {
  width: 76rpx; height: 76rpx; border-radius: 24rpx; margin: 0 auto;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 700;
}
.ci-name { font-size: 25rpx; font-weight: 600; margin-top: 14rpx; }
.ci-count { font-size: 20rpx; color: var(--ink-4); margin-top: 4rpx; }

/* ---------- 话题 ---------- */
.topic-wrap { padding: 26rpx 0 0; }
.topic-scroll { white-space: nowrap; display: flex; padding: 0 24rpx;
  height: 92rpx;
  box-sizing: border-box;
}
.topic {
  flex-shrink: 0; margin-right: 16rpx;
  background: #fff; border-radius: 999rpx;
  padding: 12rpx 26rpx; font-size: 25rpx; color: var(--ink-2);
  box-shadow: 0 3rpx 12rpx rgba(31, 35, 40, 0.05);
}
.topic-hash { color: var(--brand); font-weight: 700; margin-right: 2rpx; }
.topic-count { font-size: 19rpx; color: var(--ink-4); margin-left: 8rpx; }

/* ---------- 排序 ---------- */
.sort-bar { display: flex; align-items: center; gap: 44rpx; padding: 30rpx 32rpx 16rpx; }
.sort-item { position: relative; font-size: 30rpx; color: var(--ink-3); }
.sort-item.on { color: var(--ink); font-weight: 700; font-size: 32rpx; }
.sort-line { height: 6rpx; border-radius: 3rpx; margin-top: 8rpx; background: transparent; width: 100%; }
.sort-item.on .sort-line { background: var(--brand-grad); }

/* ---------- 帖子 ---------- */
.post-list { padding: 0 24rpx; }
.more-tip { text-align: center; font-size: 22rpx; color: var(--ink-4); padding: 30rpx 0; }
.skeleton-wrap { padding: 0 24rpx; }
.sk-post { height: 360rpx; margin-bottom: 24rpx; border-radius: var(--radius); }
.bottom-pad { height: calc(180rpx + env(safe-area-inset-bottom)); }
