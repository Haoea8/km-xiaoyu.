/* ---------- 作者 ---------- */
.p-head {
  display: flex; align-items: center; gap: 18rpx;
  margin: 8rpx 24rpx 0; padding: 26rpx 28rpx;
  background: #fff; border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}
.p-avatar { width: 84rpx; height: 84rpx; border-radius: 26rpx; background: #EDEFF2; flex-shrink: 0; }
.p-author-main { flex: 1; min-width: 0; }
.p-name { font-size: 30rpx; font-weight: 600; display: flex; align-items: center; gap: 10rpx; }
.p-cert {
  font-size: 18rpx; color: var(--green); background: #E6F8F0;
  padding: 2rpx 10rpx; border-radius: 6rpx; font-weight: 400;
}
.p-sub { font-size: 22rpx; color: var(--ink-4); margin-top: 6rpx; }
.p-circle { font-weight: 500; }
.p-more { font-size: 26rpx; color: var(--ink-3); padding: 0 10rpx; flex-shrink: 0; }

/* ---------- 内容 ---------- */
.p-body {
  background: #fff; margin: 0 24rpx; padding: 0 28rpx 28rpx;
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
}
.p-content { font-size: 31rpx; line-height: 1.75; white-space: pre-wrap; word-break: break-all; }
.p-images { display: flex; flex-direction: column; gap: 16rpx; margin-top: 22rpx; }
.p-img { width: 100%; border-radius: 18rpx; background: #F1F3F5; }
.p-topics { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 24rpx; }
.p-topic { font-size: 24rpx; color: var(--brand); background: var(--brand-soft); padding: 8rpx 22rpx; border-radius: 999rpx; }

/* ---------- 操作 ---------- */
.p-actions {
  display: flex; align-items: center; justify-content: space-around;
  margin: 20rpx 24rpx 0; padding: 26rpx 0;
  background: #fff; border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}
.pa-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; font-size: 22rpx; color: var(--ink-2); }
.pa-ico { font-size: 38rpx; color: var(--ink-3); line-height: 1; }
.pa-item.on .pa-ico { color: #FF3B6B; }
.pa-item.on { color: #FF3B6B; }

/* ---------- 头像：字标 + 图片双层，永不空白 ---------- */
/* 第一层是昵称首字字标（背景+前景色由 JS 按昵称哈希算出来），
   真实头像图片盖在第二层。图片正常就完全盖住；图片为空或加载失败
   就露出字标 —— 所以头像**永远不会是一块白**。
   （头像为空/失效的三种常见原因：用户没设置过头像、是 /static/avatars/aXX.jpg
     这类路径但云存储里没有文件、是刚上传的 fileID / 已过期的临时链接。） */
.av {
  position: relative; overflow: hidden; flex-shrink: 0;
  width: 64rpx; height: 64rpx; border-radius: 20rpx;
}
.av-lg { width: 84rpx; height: 84rpx; border-radius: 26rpx; }
.av-sm { width: 56rpx; height: 56rpx; border-radius: 18rpx; }
.av-txt {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 600; line-height: 1;
}
.av-lg .av-txt { font-size: 36rpx; }
.av-sm .av-txt { font-size: 26rpx; }
.av-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }

/* ---------- 评论 ---------- */
.c-sec { margin: 24rpx 24rpx 0; padding: 28rpx; background: #fff; border-radius: var(--radius-lg); }
.c-title { font-size: 30rpx; font-weight: 700; margin-bottom: 24rpx; }
.c-empty { font-size: 24rpx; color: var(--ink-4); text-align: center; padding: 40rpx 0; }
/* 「评论没能加载出来 · 点此重试」：可点击，与空态区分开（不是"没人评论"） */
.c-hint { font-size: 24rpx; color: var(--brand); text-align: center; padding: 32rpx 0; }
.c-item { display: flex; gap: 18rpx; padding: 22rpx 0; border-bottom: 2rpx solid var(--line); }
.c-item:last-child { border-bottom: none; }
.c-avatar { width: 64rpx; height: 64rpx; border-radius: 20rpx; background: #EDEFF2; flex-shrink: 0; }
.c-main { flex: 1; min-width: 0; }
.c-name { font-size: 24rpx; color: var(--ink-2); font-weight: 500; }
.c-text { font-size: 28rpx; line-height: 1.6; margin-top: 8rpx; word-break: break-all; }
/* 回复关系：显示「回复 @某人：被回复内容摘要」，让人一眼看懂上下文 */
.c-quote {
  margin-top: 8rpx; padding: 8rpx 14rpx; border-radius: 10rpx;
  background: #F4F6F8; font-size: 23rpx; color: var(--ink-3);
  word-break: break-all;
}

/* ---------- 二级回复（缩进挂在这一楼下，默认只露 2 条） ---------- */
.c-replies {
  margin-top: 14rpx; padding-left: 18rpx;
  border-left: 4rpx solid var(--line);
}
.c-reply-item { display: flex; gap: 14rpx; padding: 14rpx 0; }
.c-reply-item + .c-reply-item { border-top: 2rpx solid var(--line); }
/* 「回复 某某」跟在昵称后面 */
.c-reply-to { color: var(--ink-3); font-weight: 400; margin-left: 10rpx; }
.c-more {
  margin-top: 12rpx; font-size: 23rpx; color: var(--brand);
  display: flex; align-items: center; gap: 6rpx;
}
.c-more-ico { font-size: 18rpx; }

.c-meta { display: flex; align-items: center; gap: 26rpx; margin-top: 12rpx; }
.c-time { font-size: 21rpx; color: var(--ink-4); }
.c-reply { font-size: 21rpx; color: var(--ink-3); }

/* ---------- 加载失败 ---------- */
.load-err { margin: 140rpx 60rpx 0; text-align: center; }
.le-ico { font-size: 76rpx; line-height: 1; }
.le-txt { margin-top: 20rpx; font-size: 26rpx; color: var(--ink-3); word-break: break-all; }
.le-btn {
  margin: 36rpx auto 0; width: 260rpx; height: 78rpx; border-radius: 999rpx;
  background: var(--brand-grad); color: #fff; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
}

/* ---------- 底部输入 ---------- */
.c-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
  background: #fff; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--line);
}
.c-reply-tip {
  font-size: 22rpx; color: var(--ink-3); padding: 0 0 12rpx;
  display: flex; align-items: center; gap: 12rpx;
}
.c-reply-cancel { color: var(--brand); font-size: 28rpx; }
.c-bar-row { display: flex; align-items: center; gap: 16rpx; }
.c-input {
  flex: 1; height: 72rpx; background: #F4F6F8; border-radius: 999rpx;
  padding: 0 28rpx; font-size: 28rpx;
}
.c-ph { color: var(--ink-4); font-size: 26rpx; }
.c-send {
  height: 72rpx; padding: 0 34rpx; border-radius: 999rpx;
  background: #C9CFD8; color: #fff; font-size: 27rpx;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
/* 有输入 → 变红（品牌红渐变）+ 加阴影，和聊天页的发送按钮保持一致。
   没输入就是上面的灰色。 */
.c-send.on { background: var(--brand-grad); font-weight: 600; box-shadow: 0 6rpx 16rpx rgba(31, 164, 91, 0.26); }

.footer-pad { height: calc(160rpx + env(safe-area-inset-bottom)); }
.skeleton-wrap { padding-top: 20rpx; }

/* ---------- 评论配图（最多 3 张） ---------- */
.c-imgs { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.c-img { width: 132rpx; height: 132rpx; border-radius: 12rpx; background: #EDEFF2; }

/* 输入条里已选的图 */
.c-picked { display: flex; align-items: center; gap: 14rpx; padding: 12rpx 4rpx 0; }
.cp-item { position: relative; width: 108rpx; height: 108rpx; }
.cp-img { width: 108rpx; height: 108rpx; border-radius: 12rpx; background: #EDEFF2; }
.cp-del {
  position: absolute; right: -8rpx; top: -8rpx;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(0, 0, 0, 0.55); color: #fff;
  font-size: 24rpx; line-height: 34rpx; text-align: center;
}
.cp-count { font-size: 22rpx; color: var(--ink-4); }
.c-pick {
  flex-shrink: 0; width: 68rpx; height: 68rpx; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 23rpx; color: var(--ink-3); background: #F2F3F5;
}
