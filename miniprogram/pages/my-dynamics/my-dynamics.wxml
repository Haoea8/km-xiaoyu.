<view class="page-wrap">
  <navbar title="{{isMe ? '我的动态' : 'TA 的动态'}}" back="{{true}}"></navbar>

  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{tab === item.key ? 'on' : ''}}"
      data-k="{{item.key}}"
      bindtap="onTab">{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>

  <block wx:elif="{{list.length}}">
    <view class="dyn" wx:for="{{list}}" wx:key="id" data-i="{{index}}" bindtap="open">
      <view class="dy-head">
        <text class="dy-type t-{{item.type}}">{{item.icon}} {{item.typeText}}</text>
        <text class="dy-time">{{item.timeText}}</text>
      </view>
      <view class="dy-body">
        <view class="dy-text">
          <view class="dy-title">{{item.title}}</view>
          <view class="dy-meta">{{item.meta}}</view>
        </view>
        <image wx:if="{{item.cover}}" class="dy-cover" src="{{item.cover}}" mode="aspectFill"></image>
      </view>
    </view>
  </block>

  <empty wx:else text="还没有发过动态" sub="{{isMe ? '去圈子发个帖、或到校园墙说两句' : 'TA 还没发过内容'}}"></empty>

  <view class="pad"></view>
</view>
