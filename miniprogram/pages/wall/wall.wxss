.nb-post {
  font-size: 24rpx; color: #fff; font-weight: 600;
  background: var(--brand-grad); padding: 6rpx 24rpx; border-radius: 999rpx;
}

/* ---------- 头部 ---------- */
.hero {
  position: relative; overflow: hidden;
  margin: 8rpx 24rpx 0; padding: 40rpx 32rpx 36rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, #FFD84D 0%, #FFC53D 55%, #F5A623 100%);
  color: #fff;
  box-shadow: 0 14rpx 34rpx rgba(214, 51, 108, 0.24);
}
.hero-glow {
  position: absolute; right: -80rpx; top: -80rpx;
  width: 280rpx; height: 280rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.36), transparent 70%);
}
.hero-title { position: relative; font-size: 50rpx; font-weight: 800; letter-spacing: 2rpx; }
.hero-sub { position: relative; font-size: 24rpx; opacity: 0.92; margin-top: 12rpx; }
.hero-actions { position: relative; display: flex; gap: 20rpx; margin-top: 32rpx; }
.ha-btn {
  flex: 1; height: 76rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  font-size: 26rpx; font-weight: 600;
}
.ha-btn:active { background: rgba(255, 255, 255, 0.34); }
.ha-ico { font-size: 28rpx; }

/* ---------- 筛选 ---------- */
.filter { padding: 26rpx 24rpx 8rpx; }
.tabs { display: flex; gap: 14rpx; }
.tab {
  flex: 1; height: 68rpx; border-radius: 999rpx;
  background: #fff; border: 2rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: var(--ink-2);
}
.tab.on {
  background: linear-gradient(135deg, #FFD24D, #F5A623); color: #fff;
  border-color: transparent; font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(214, 51, 108, 0.24);
}
.sorts { display: flex; gap: 34rpx; padding: 20rpx 8rpx 0; }
.sort { font-size: 25rpx; color: var(--ink-3); }
.sort.on { color: var(--ink); font-weight: 700; }

/* ---------- 卡片 ---------- */
.list { padding: 12rpx 24rpx 0; }
.w-card {
  background: #fff; border-radius: var(--radius-lg);
  padding: 26rpx; margin-bottom: 22rpx;
  box-shadow: var(--shadow);
}
.w-head { display: flex; align-items: center; gap: 16rpx; }
.w-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, #C9B6FF, #9C7BFF);
  color: #fff; font-size: 28rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.w-main { flex: 1; min-width: 0; }
.w-name { font-size: 26rpx; font-weight: 600; display: flex; align-items: center; gap: 10rpx; }
.w-badge {
  font-size: 18rpx; padding: 2rpx 12rpx; border-radius: 6rpx; font-weight: 400;
  background: #FFF3C4; color: #E09600;
}
.w-badge.all { background: #FFF6DE; color: #178A4A; }
.w-time { font-size: 21rpx; color: var(--ink-4); margin-top: 4rpx; }
.w-more { font-size: 26rpx; color: var(--ink-4); padding: 0 10rpx; flex-shrink: 0; }

.w-content {
  font-size: 29rpx; line-height: 1.72; margin-top: 20rpx;
  word-break: break-all; white-space: pre-wrap;
}
.w-to { color: #E09600; font-weight: 600; }

.w-images { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.w-img { width: 200rpx; height: 200rpx; border-radius: 14rpx; background: #F1F3F5; }
.w-img.single { width: 400rpx; height: 300rpx; }

.w-foot {
  display: flex; align-items: center; gap: 34rpx;
  margin-top: 22rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line);
}
.wf-act { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: var(--ink-3); }
.wf-ico { font-size: 30rpx; color: var(--ink-4); line-height: 1; }
.wf-act.on { color: #FF3B6B; }
.wf-act.on .wf-ico { color: #FF3B6B; }
.wf-detail { margin-left: auto; font-size: 23rpx; color: var(--ink-4); }

.more-tip { text-align: center; font-size: 22rpx; color: var(--ink-4); padding: 30rpx 0; }
.skeleton-wrap { padding: 12rpx 24rpx 0; }
.sk-card { height: 320rpx; margin-bottom: 22rpx; border-radius: var(--radius-lg); }
.bottom-pad { height: calc(180rpx + env(safe-area-inset-bottom)); }

/* ---------- 发布面板 ---------- */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 200;
  background: rgba(0, 0, 0, 0.5);
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.26s ease both;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: none; } }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.sheet-title { font-size: 34rpx; font-weight: 700; }
.sheet-close { font-size: 44rpx; color: var(--ink-4); line-height: 1; padding: 0 10rpx; }

.type-row { display: flex; gap: 16rpx; margin-bottom: 22rpx; }
.type-btn {
  flex: 1; height: 76rpx; border-radius: 999rpx;
  background: #F4F6F8; color: var(--ink-2);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx;
}
.type-btn.on {
  background: linear-gradient(135deg, #FFD24D, #F5A623); color: #fff; font-weight: 600;
}

.to-input {
  width: 100%; height: 76rpx; background: #F8F9FB; border-radius: 16rpx;
  padding: 0 24rpx; font-size: 27rpx; margin-bottom: 16rpx; box-sizing: border-box;
}
.sheet-content {
  width: 100%; min-height: 220rpx; background: #F8F9FB; border-radius: 16rpx;
  padding: 22rpx; font-size: 29rpx; line-height: 1.65; box-sizing: border-box;
}
.ph { color: var(--ink-4); }

.sheet-imgs { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 20rpx; }
.img-cell { position: relative; width: 150rpx; height: 150rpx; }
.img { width: 150rpx; height: 150rpx; border-radius: 14rpx; background: #F1F3F5; }
.img-del {
  position: absolute; top: -10rpx; right: -10rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(0, 0, 0, 0.62); color: #fff;
  display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}
.img-add {
  width: 150rpx; height: 150rpx; border-radius: 14rpx;
  border: 2rpx dashed var(--ink-4); background: #FAFBFC;
  display: flex; align-items: center; justify-content: center;
  font-size: 46rpx; color: var(--ink-4); font-weight: 300;
}

.anon-row { display: flex; align-items: center; gap: 12rpx; margin-top: 24rpx; }
.checkbox {
  width: 34rpx; height: 34rpx; border-radius: 50%;
  border: 3rpx solid var(--ink-4); box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
}
.checkbox.on { background: #E09600; border-color: #E09600; }
.tick {
  width: 14rpx; height: 8rpx;
  border-left: 3rpx solid #fff; border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg) translate(1rpx, -2rpx); opacity: 0;
}
.checkbox.on .tick { opacity: 1; }
.anon-text { font-size: 25rpx; color: var(--ink-2); }

.sheet-submit {
  margin-top: 26rpx; height: 92rpx; border-radius: 999rpx;
  background: linear-gradient(135deg, #FFD24D, #F5A623); color: #fff;
  font-size: 31rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 26rpx rgba(214, 51, 108, 0.3);
}
.sheet-submit.disabled { opacity: 0.6; }
.sheet-tip { text-align: center; font-size: 21rpx; color: var(--ink-4); margin-top: 16rpx; }
