.nb-submit {
  font-size: 24rpx; color: var(--ink-4);
  padding: 8rpx 26rpx; border-radius: 999rpx; background: #F2F4F7;
}
.nb-submit.on { color: #fff; background: var(--brand-grad); font-weight: 600; }

.card { margin: 20rpx 24rpx 0; padding: 28rpx; }

/* ---------- 内容 ---------- */
.content {
  width: 100%; min-height: 260rpx; font-size: 31rpx; line-height: 1.7;
  box-sizing: border-box;
}
.ph { color: var(--ink-4); }
.count { text-align: right; font-size: 21rpx; color: var(--ink-4); margin-top: 10rpx; }

/* ---------- 图片 ---------- */
.img-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.img-cell { position: relative; width: 200rpx; height: 200rpx; }
.img { width: 200rpx; height: 200rpx; border-radius: 16rpx; background: #F1F3F5; }
.img-del {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: rgba(0, 0, 0, 0.62); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; line-height: 1;
}
.img-add {
  width: 200rpx; height: 200rpx; border-radius: 16rpx;
  border: 2rpx dashed var(--ink-4); background: #FAFBFC;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 8rpx;
}
.add-plus { font-size: 54rpx; color: var(--ink-4); line-height: 1; font-weight: 300; }
.add-text { font-size: 22rpx; color: var(--ink-4); }

/* ---------- 行 ---------- */
.row { display: flex; align-items: center; justify-content: space-between; }
.row-label { font-size: 28rpx; font-weight: 500; }
.row-value { font-size: 27rpx; color: var(--ink-2); display: flex; align-items: center; gap: 8rpx; }
.arrow { color: var(--ink-4); font-size: 32rpx; }

.card-title { font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; }
.opt { font-size: 21rpx; color: var(--ink-4); font-weight: 400; margin-left: 8rpx; }

/* ---------- 话题 ---------- */
.topic-selected { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 20rpx; }
.ts-item {
  font-size: 24rpx; color: var(--brand); background: var(--brand-soft);
  padding: 10rpx 22rpx; border-radius: 999rpx;
}
.ts-del { color: var(--brand); font-size: 26rpx; }

.topic-input-row { display: flex; align-items: center; gap: 16rpx; }
.topic-input {
  flex: 1; height: 72rpx; background: #F4F6F8; border-radius: 999rpx;
  padding: 0 26rpx; font-size: 27rpx;
}
.topic-add {
  height: 72rpx; padding: 0 32rpx; border-radius: 999rpx;
  background: var(--brand-soft); color: var(--brand);
  font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.hot-topics { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 22rpx; }
.ht {
  font-size: 23rpx; color: var(--ink-2); background: #F4F6F8;
  padding: 10rpx 22rpx; border-radius: 999rpx;
}
.ht:active { background: var(--brand-soft); color: var(--brand); }

/* ---------- 提示与底栏 ---------- */
.tip { font-size: 22rpx; color: var(--ink-4); padding: 28rpx 40rpx 0; line-height: 1.6; text-align: center; }
.footer-pad { height: calc(180rpx + env(safe-area-inset-bottom)); }
.footer {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  background: #fff; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex; align-items: center; gap: 18rpx;
  box-shadow: 0 -6rpx 24rpx rgba(31, 35, 40, 0.06);
}
.btn-cancel {
  flex: 1; height: 88rpx; border-radius: 999rpx;
  border: 2rpx solid var(--line); color: var(--ink-2);
  display: flex; align-items: center; justify-content: center; font-size: 29rpx;
}
.btn-submit {
  flex: 2; height: 88rpx; border-radius: 999rpx;
  background: var(--brand-grad); color: #fff; font-weight: 600;
  display: flex; align-items: center; justify-content: center; font-size: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(31, 164, 91, 0.26);
}
.btn-submit.disabled { opacity: 0.6; }
