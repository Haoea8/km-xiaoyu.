<view class="page-wrap">
  <!-- 导航栏右侧不再放「上传」：右下角已有悬浮 + 按钮，顶部那个既重复又被胶囊挤 -->
  <navbar title="学习资源" back="{{true}}"></navbar>

  <!-- 搜索 -->
  <view class="search-wrap">
    <view class="search">
      <view class="s-ico"></view>
      <input
        class="s-input"
        value="{{keyword}}"
        placeholder="搜索资料名 / 课程 / 标签"
        placeholder-class="s-ph"
        confirm-type="search"
        bindconfirm="onSearch" />
      <view wx:if="{{keyword || category || course}}" class="s-clear" bindtap="clearAll">清空</view>
    </view>
  </view>

  <!-- 分类 -->
  <scroll-view class="cat-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
    <view
      class="cat {{category===''?'on':''}}"
      data-k=""
      bindtap="onCategory">全部</view>
    <view
      wx:for="{{categories}}"
      wx:key="code"
      class="cat {{category===item.code?'on':''}}"
      data-k="{{item.code}}"
      bindtap="onCategory">{{item.name}}</view>
  </scroll-view>

  <!-- 课程 -->
  <scroll-view wx:if="{{courses.length}}" class="course-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
    <view
      wx:for="{{courses}}"
      wx:key="name"
      class="course {{course===item.name?'on':''}}"
      data-k="{{item.name}}"
      bindtap="onCourse">{{item.name}} <text class="course-n">{{item.count}}</text></view>
  </scroll-view>

  <!-- 排序 -->
  <view class="sort-bar">
    <view
      wx:for="{{sorts}}"
      wx:key="key"
      class="sort {{sort===item.key?'on':''}}"
      data-k="{{item.key}}"
      bindtap="onSort">{{item.label}}</view>
  </view>

  <!-- 列表 -->
  <view class="list">
    <view class="r-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="r-type" style="background:{{item.typeColor}}1A;color:{{item.typeColor}}">
        <text class="r-ext">{{item.typeText}}</text>
        <text class="r-size">{{item.sizeText}}</text>
      </view>
      <view class="r-main">
        <view class="r-title ellipsis2">{{item.title}}</view>
        <view class="r-desc ellipsis" wx:if="{{item.desc}}">{{item.desc}}</view>
        <view class="r-meta">
          <view class="r-course" wx:if="{{item.course}}">{{item.course}}</view>
          <text class="r-stat">⬇ {{item.downloads || 0}}</text>
          <text class="r-stat">♥ {{item.likeCount || 0}}</text>
          <text class="r-time">{{item.timeText}}</text>
        </view>
      </view>
      <view class="r-go">下载</view>
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="more-tip">正在加载…</view>
  <view wx:elif="{{!hasMore && list.length}}" class="more-tip">— 到底啦 —</view>

  <empty wx:if="{{!loading && !list.length}}" text="没有找到相关资料" sub="换个关键词，或上传你手里的资料"></empty>

  <view wx:if="{{loading}}" class="skeleton-wrap">
    <view class="skeleton sk-card" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>

  <view class="bottom-pad"></view>
  <view class="fab" bindtap="goUpload">＋</view>
</view>
