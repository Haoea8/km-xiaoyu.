/* ---------- 搜索 ---------- */
.search-wrap { padding: 8rpx 24rpx 0; display: flex; align-items: center; gap: 16rpx; }
.search {
  flex: 1; min-width: 0;
  display: flex; align-items: center; gap: 14rpx;
  background: #fff; border-radius: 999rpx;
  padding: 0 26rpx; height: 80rpx; box-shadow: var(--shadow);
}

/* ---------- AI 找货 ---------- */
.ai-find {
  flex-shrink: 0; height: 80rpx; padding: 0 22rpx; border-radius: 999rpx;
  display: flex; align-items: center; gap: 8rpx;
  background: linear-gradient(135deg, #4CD08A, #1FA45B); color: #fff;
  font-size: 25rpx; box-shadow: 0 6rpx 18rpx rgba(108, 92, 231, 0.28);
}
.ai-find:active { opacity: 0.85; }
.ai-find.busy { opacity: 0.55; }
.ai-spark {
  font-size: 21rpx; font-weight: 700; line-height: 1.5;
  background: rgba(255, 255, 255, 0.24); border-radius: 6rpx; padding: 0 8rpx;
}

.ai-panel {
  margin: 20rpx 24rpx 0; padding: 20rpx 0 22rpx 20rpx;
  background: #fff; border-radius: 20rpx; box-shadow: var(--shadow);
}
.ai-head { display: flex; align-items: flex-start; gap: 10rpx; padding-right: 22rpx; }
.ai-badge {
  flex-shrink: 0; font-size: 20rpx; font-weight: 700; line-height: 1.7; color: #fff;
  background: linear-gradient(135deg, #4CD08A, #1FA45B); border-radius: 6rpx; padding: 0 8rpx;
}
.ai-sum { flex: 1; font-size: 25rpx; line-height: 1.45; color: var(--ink-2); }
.ai-close { flex-shrink: 0; font-size: 24rpx; color: var(--ink-4); padding: 0 4rpx; }
.ai-tip-line { font-size: 21rpx; color: #B08900; margin-top: 8rpx; }
/* 横向 scroll-view **必须给高度**，否则在真机上会塌成 0 高、内容被裁
   （check-scroll-height.js 会拦这一条）。340rpx ≈ 图 150 + 两行标题 + 价格 + 理由 */
.ai-scroll { height: 340rpx; white-space: nowrap; margin-top: 14rpx; }
.ai-card { display: inline-flex; flex-direction: column; width: 210rpx; margin-right: 16rpx; vertical-align: top; }
.ai-img { width: 210rpx; height: 150rpx; border-radius: 14rpx; background: #F1F3F5; }
.ai-title { font-size: 24rpx; line-height: 1.35; margin-top: 8rpx; color: var(--ink-1); white-space: normal; }
.ai-price { font-size: 27rpx; font-weight: 700; color: #1FA45B; margin-top: 4rpx; }
.ai-reason { font-size: 20rpx; line-height: 1.35; color: var(--ink-4); margin-top: 2rpx; white-space: normal; }
.s-ico {
  width: 26rpx; height: 26rpx; border-radius: 50%;
  border: 4rpx solid var(--ink-4); position: relative; flex-shrink: 0;
}
.s-ico::after {
  content: ''; position: absolute; right: -12rpx; bottom: -8rpx;
  width: 14rpx; height: 4rpx; background: var(--ink-4); transform: rotate(45deg);
}
.s-input { flex: 1; font-size: 28rpx; }
.s-ph { color: var(--ink-4); }
.s-clear {
  width: 40rpx; height: 40rpx; border-radius: 50%; background: #E8EBEF;
  color: var(--ink-3); display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; line-height: 1;
}

/* ---------- 词块 ---------- */
.sec { padding: 30rpx 24rpx 0; }
.sec-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.sec-title { font-size: 28rpx; font-weight: 700; }
.sec-more { font-size: 22rpx; color: var(--ink-4); }
.words { display: flex; flex-wrap: wrap; gap: 16rpx; }
.word {
  font-size: 24rpx; color: var(--ink-2); background: #fff;
  padding: 12rpx 26rpx; border-radius: 999rpx;
  box-shadow: 0 3rpx 12rpx rgba(31, 35, 40, 0.05);
}
.word.hot { color: var(--brand); background: var(--brand-soft); }
.word:active { opacity: 0.75; }

/* ---------- 分区 ---------- */
.zone-scroll { white-space: nowrap; display: flex; padding: 26rpx 24rpx 0;
  height: 92rpx;
  box-sizing: border-box;
}
.zone-chip {
  flex-shrink: 0; margin-right: 14rpx;
  font-size: 25rpx; color: var(--ink-2);
  background: #fff; border: 2rpx solid var(--line);
  padding: 12rpx 28rpx; border-radius: 999rpx;
}
.zone-chip.on { font-weight: 600; }
.zone-chip.on:first-child {
  background: var(--brand-grad); color: #fff; border-color: transparent;
}

/* ---------- 排序 ---------- */
.sort-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 26rpx 32rpx 14rpx;
}
.sort-list { display: flex; gap: 30rpx; }
.sort { font-size: 26rpx; color: var(--ink-3); }
.sort.on { color: var(--brand); font-weight: 700; }
.total { font-size: 22rpx; color: var(--ink-4); }

/* ---------- 列表 ---------- */
.list { padding: 0 24rpx; }
.l-card {
  display: flex; gap: 20rpx;
  background: #fff; border-radius: var(--radius);
  padding: 22rpx; margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}
.l-card:active { background: #FAFBFC; }
.l-img { width: 200rpx; height: 200rpx; border-radius: 18rpx; background: #F1F3F5; flex-shrink: 0; }
/* 封面彻底加载失败时的占位（重试一次仍失败才出现）：给明确文字，不留一块纯灰 */
.l-img-fail {
  display: flex; align-items: center; justify-content: center;
  text-align: center; padding: 0 12rpx; box-sizing: border-box;
  font-size: 20rpx; line-height: 1.35; color: #9AA0A6;
}
.l-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.l-title { font-size: 29rpx; font-weight: 600; line-height: 1.42; }
.l-tags { display: flex; gap: 12rpx; margin-top: 12rpx; flex-wrap: wrap; }
.l-tag {
  font-size: 20rpx; color: var(--brand); background: var(--brand-soft);
  padding: 3rpx 14rpx; border-radius: 6rpx;
}
.l-tag.gray { color: var(--ink-3); background: #F2F4F7; }
.l-bottom { display: flex; align-items: baseline; justify-content: space-between; margin-top: auto; padding-top: 12rpx; }
.l-seller { font-size: 21rpx; color: var(--ink-4); }

.more-tip { text-align: center; font-size: 22rpx; color: var(--ink-4); padding: 30rpx 0; }
.skeleton-wrap { padding: 0 24rpx; }
.sk-row { height: 244rpx; margin-bottom: 20rpx; border-radius: var(--radius); }
.bottom-pad { height: calc(180rpx + env(safe-area-inset-bottom)); }
