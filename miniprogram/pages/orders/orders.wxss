/* ---------- 角色切换 ---------- */
.role-tabs {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 20rpx 24rpx 4rpx;
}
.role-tab {
  flex: 1; height: 72rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: var(--ink-2); background: #fff;
  border: 2rpx solid var(--line);
}
.role-tab.on {
  background: var(--brand-grad); color: #fff; border-color: transparent;
  font-weight: 600; box-shadow: 0 8rpx 18rpx rgba(255, 90, 60, 0.24);
}

/* ---------- 状态筛选 ---------- */
/* 7 个标签合计约 881rpx，超过可用宽 702rpx（750 − 左右各 24rpx），
   所以用**换行**布局：第 1 行 5 个、第 2 行 2 个，全部可见。
   原来用横向 scroll-view 且隐藏了滚动条 —— 第 5 个被硬切、后 2 个看不到，
   看起来就是「显示不全」。（rpx 等比缩放，每行放几个在所有机型上一致。） */
.status-bar {
  display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx;
  padding: 16rpx 24rpx 8rpx;
}
.status-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx; font-size: 25rpx; color: var(--ink-2);
  background: #fff; border: 2rpx solid var(--line);
}
.status-chip.on {
  background: var(--brand-soft); color: var(--brand);
  border-color: rgba(255, 90, 60, 0.3); font-weight: 600;
}

/* ---------- 订单卡片 ---------- */
.list { padding: 12rpx 24rpx 0; }
.order-card {
  background: #fff; border-radius: var(--radius); box-shadow: var(--shadow);
  padding: 26rpx; margin-bottom: 24rpx;
}
.o-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.o-shop { display: flex; align-items: center; gap: 12rpx; }
.o-shop-ico {
  position: relative; overflow: hidden;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #EEF1F5; color: var(--ink-2);
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 600;
}
.o-shop-txt { line-height: 1; }
.o-shop-img {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
}
.o-shop-name { font-size: 26rpx; font-weight: 600; }
.o-status { font-size: 25rpx; font-weight: 600; }

.o-goods { display: flex; gap: 20rpx; }
.o-img { width: 160rpx; height: 160rpx; border-radius: 16rpx; background: #F1F3F5; flex-shrink: 0; }
.o-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.o-title {
  font-size: 28rpx; font-weight: 500; line-height: 1.45;
  overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.o-spec { font-size: 22rpx; color: var(--ink-3); margin-top: 8rpx; }
.o-qty { font-size: 23rpx; color: var(--ink-3); margin-top: auto; }
.o-price-col { display: flex; align-items: flex-start; }
.o-price { font-size: 28rpx; font-weight: 600; white-space: nowrap; }

.o-amount {
  display: flex; align-items: center; justify-content: flex-end; gap: 12rpx;
  margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line);
}
.o-amount-label { font-size: 24rpx; color: var(--ink-3); }
.o-amount-val { font-size: 34rpx; color: var(--brand); font-weight: 700; }
.o-yuan { font-size: 24rpx; }
.o-time { font-size: 21rpx; color: var(--ink-4); margin-top: 8rpx; }

.o-acts {
  display: flex; align-items: center; justify-content: flex-end;
  gap: 16rpx; margin-top: 22rpx; flex-wrap: wrap;
}
.o-btn {
  height: 64rpx; padding: 0 34rpx; border-radius: 999rpx;
  border: 2rpx solid var(--line); background: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 25rpx; color: var(--ink-2);
}
.o-btn-main {
  background: var(--brand-grad); color: #fff; border-color: transparent;
  font-weight: 600; box-shadow: 0 6rpx 16rpx rgba(255, 90, 60, 0.24);
}
.o-btn:active { opacity: 0.86; }

.skeleton-wrap { padding: 12rpx 24rpx 0; }
.sk-card { height: 320rpx; margin-bottom: 24rpx; border-radius: var(--radius); }
.footer-pad { height: 60rpx; }
