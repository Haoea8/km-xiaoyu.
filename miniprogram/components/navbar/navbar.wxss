.nb {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: #fff;
}
.nb-transparent { background: transparent; }
.nb-line { box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.05); }
.nb-inner {
  display: flex; align-items: center; justify-content: center;
  padding: 0 24rpx; position: relative;
}
.nb-title {
  font-size: 34rpx; font-weight: 600; color: #1F2328;
  max-width: 400rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.nb-title-light { color: #fff; }
.nb-left { position: absolute; left: 16rpx; display: flex; align-items: center; }
.nb-right { position: absolute; right: 16rpx; display: flex; align-items: center; }
.nb-back {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.nb-back:active { background: rgba(0, 0, 0, 0.05); }
.nb-arrow {
  width: 20rpx; height: 20rpx;
  border-left: 4rpx solid #1F2328;
  border-bottom: 4rpx solid #1F2328;
  transform: rotate(45deg); margin-left: 8rpx;
  border-radius: 2rpx;
}
.nb-holder { width: 100%; }
